# --- Database (Neon pooled connection string) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Encryption (generate each with: openssl rand -base64 32) ---
# Field-level AES-256-GCM keys. Rotate by adding FIELD_KEY_2 and bumping FIELD_KEY_CURRENT.
FIELD_KEY_1=
FIELD_KEY_CURRENT=1
# HMAC key for blind indexes (searchable NIT without decrypting)
BLIND_INDEX_KEY=

# --- Rate limiting (Upstash Redis; REQUIRED in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
APP_URL=http://localhost:3000
